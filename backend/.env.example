# Get a key at https://console.anthropic.com (the account needs credits)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Your Firebase project ID, used to check that requests come from a signed-in user
FIREBASE_PROJECT_ID=

# Comma-separated list of sites allowed to call this API
ALLOWED_ORIGINS=http://localhost:5173

# Set to true ONLY to test locally without Firebase login
SKIP_AUTH=false
