# Firebase web app config (Firebase console > Project settings > Your apps)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Python backend URL. Leave empty in development (Vite proxies /api to localhost:8000).
# In production set it to your deployed backend, e.g. https://glowplate-api.onrender.com
VITE_API_URL=
